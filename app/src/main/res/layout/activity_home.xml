<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E0F7FA">

    <!-- FRAGMENT CONTENT -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bottom_nav_background"
        android:elevation="12dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homeNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Home"
                app:tint="#102A43" />

            <TextView
                android:id="@+id/homeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOME"
                android:textColor="#102A43"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- CHAT -->
        <LinearLayout
            android:id="@+id/chatNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/chatIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@android:drawable/ic_dialog_email"
                android:contentDescription="Chat"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/chatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHAT"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- MAP -->
        <LinearLayout
            android:id="@+id/mapNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/mapIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="Map"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/mapText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAP"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- GUIDE -->
        <LinearLayout
            android:id="@+id/guideNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/guideIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="Guide"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/guideText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUIDE"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SERVICES -->
        <LinearLayout
            android:id="@+id/servicesNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/servicesIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@android:drawable/ic_menu_agenda"
                android:contentDescription="Services"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/servicesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICES"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>