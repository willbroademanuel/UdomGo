<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E0F7FA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/login_header"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT COLLEGE"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Institutes &amp; Schools of UDOM"
            android:textColor="#81D4FA"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- COLLEGES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLLEGES"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap your college to update your identity"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/civeButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CIVE"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/cobeButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CoBE"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/coeseButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CoESE"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/coedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CoED"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chssButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CHSS"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/cnmsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CNMS"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>


            <!-- INSTITUTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="INSTITUTES"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/ciButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="CI"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/idsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="IDS"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>


            <!-- SCHOOLS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SCHOOLS"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/solButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="SoL"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/somdButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="SoMD"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sonphButton"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:background="@drawable/college_btn_inactive"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:text="SoNPH"
                    android:textColor="#102A43"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>