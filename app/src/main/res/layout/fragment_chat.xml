<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- CHAT HEADER -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/login_header"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UDOMGo Assistant"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="● Online • Campus Guide &amp; FAQ"
                android:textColor="#81D4FA"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/clearChatButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Clear Chat"
            android:padding="8dp" />

    </LinearLayout>


    <!-- CONVERSATION AREA -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>


    <!-- QUICK SUGGESTIONS CAROUSEL -->
    <HorizontalScrollView
        android:id="@+id/quickSuggestionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/quickChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipColleges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏛️ Colleges"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 CIVE"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipHostels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Hostels"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Library"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCafeteria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽️ Cafeteria"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳 Fees / GePG"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipSr2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 SR2 Portal"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚌 Transport"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥 Health Center"
                android:textSize="12sp"
                android:textColor="#102A43"
                android:textStyle="bold"
                android:background="@drawable/chat_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- INPUT BAR -->
    <LinearLayout
        android:id="@+id/chatInputBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="10dp">

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Ask about UDOM..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:textSize="14sp"
            android:background="@drawable/rounded_input" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chat_send_button_bg"
            android:src="@drawable/ic_send"
            android:contentDescription="Send"
            android:padding="10dp"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>