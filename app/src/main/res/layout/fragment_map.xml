<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFF7FA">

    <!-- ========================================================= -->
    <!-- MAP                                                       -->
    <!-- ========================================================= -->

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- ========================================================= -->
    <!-- TOP NAVY HEADER                                           -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
     android:background="@drawable/login_header"
        android:elevation="8dp">

        <TextView
            android:id="@+id/mapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAP"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SEARCH AREA                                               -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/searchArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="105dp"
        android:orientation="vertical"
        android:elevation="12dp">

        <!-- SEARCH BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#555555"
                android:textSize="27sp" />

            <EditText
                android:id="@+id/mapSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_input"
                android:hint="Search UDOM location"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/clearSearchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/clear_search"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />

        </LinearLayout>


        <!-- SEARCH SUGGESTIONS -->

        <ListView
            android:id="@+id/searchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:background="@drawable/suggestion_background"
            android:divider="#DDDDDD"
            android:dividerHeight="1dp"
            android:elevation="10dp"
            android:visibility="gone" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- MY LOCATION BUTTON                                        -->
    <!-- ========================================================= -->

    <ImageButton
        android:id="@+id/myLocationButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="82dp"
        android:background="@drawable/location_button_background"
        android:contentDescription="Go to my location"
        android:elevation="10dp"
        android:padding="14dp"
        android:src="@drawable/ic_my_location" />




</FrameLayout>